# Facebook Messenger Configuration
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_API_VERSION=v18.0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.4

# Server Configuration
PORT=5000
NODE_ENV=development

# Bot Configuration
BOT_NAME=مساعد العدوي
BOT_PERSONALITY=friendly and helpful Arabic-speaking assistant for Al-Adawy Group paints wholesale

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Instructions:
# 1. Copy this file to .env
# 2. Replace all values with your actual credentials
# 3. Never commit .env to git (it's in .gitignore)
# 4. Get Facebook tokens from: https://developers.facebook.com/
# 5. Get OpenAI API key from: https://platform.openai.com/api-keys
